# TEMPLATE ONLY: coding agent must wire and exercise these variables.
# No secrets in this file; no mandatory database or authentication.
APP_ENV=development
APP_ORIGIN=http://localhost:3000
INTERNAL_API_ORIGIN=http://localhost:8000
API_PREFIX=/api/v1
MAX_REQUEST_BYTES=1048576
MAX_PROJECT_IMPORT_BYTES=16777216
MAX_SWEEP_POINTS=501
MAX_RADIAL_CELLS=65536
SIMULATION_TIMEOUT_SECONDS=5
SIMULATION_MAX_ACTIVE=4
SIMULATION_MAX_QUEUED=16
SIMULATION_RATE_PER_MINUTE=60
SIMULATION_RATE_BURST=10
REGISTRY_VERSION=0.1.0-unresolved
LOG_LEVEL=INFO
# Configure trusted proxy addresses and TLS at deployment time.
